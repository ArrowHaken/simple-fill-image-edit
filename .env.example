# No real keys. Keep URLs, set secrets locally.
WAVESPEED_API_KEY=<set-locally>
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3

CATSCO_IMAGE2_HOST=203.32.85.223
CATSCO_IMAGE2_USER=root
CATSCO_IMAGE2_SSH_KEY=C:/Users/<you>/.ssh/worker2_203_32_85_223_ed25519_v2

CATSCO_MASKED_IMAGE2_BASE_URL=https://app.catsco.cc/v1
CATSCO_MASKED_IMAGE2_API_KEY=<set-locally>
CATSCO_MASKED_IMAGE2_MODEL=gpt-image-2
CATSCO_MASKED_IMAGE2_TIMEOUT=600
CATSCO_MASKED_IMAGE2_IMAGE_FIELD=image[]
# CatsCo's native-mask gateway uses JSON data URLs and CatsCo Bot auth.
CATSCO_MASKED_IMAGE2_TRANSPORT=json-data-url
CATSCO_MASKED_IMAGE2_AUTH_SCHEME=ApiKey
CATSCO_MASKED_IMAGE2_ROUTE_HEADER_NAME=X-CatsCo-Image-Provider
CATSCO_MASKED_IMAGE2_ROUTE_HEADER_VALUE=image2
CATSCO_MASKED_IMAGE2_API_KEY_FILE=C:/path/to/catsco-bot-api.key

CATSCO_INPAINT_HOST=127.0.0.1
CATSCO_INPAINT_PORT=7862
INPAINT_ANYTHING_UPSTREAM=D:/path/to/catsco-inpaint-anything-2026-upstream

